(footprint "Vishay_TCRT5000_Clips"
  (version 20241229)
  (generator "gateway")
  (layer "F.Cu")
  (descr "Vishay TCRT5000 reflective optical sensor, 10.2 x 5.8 x 7 mm, top view as the datasheet (lenses up): detector C/E left, emitter A/K right, chamfer top-right. Pads at JLCPCB/EasyEDA OPTO-TH_TCRT5000 (C2984661) positions, numbered like KiCad's CNY70 symbol (1 A, 2 K, 3 C, 4 E); 2.5 mm holes for the two mounting clips as KiCad's Vishay_TCRT5000")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -4.2) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text value "TCRT5000" (at 0 4.2) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_poly (pts (xy -5.1 -2.9) (xy 4.1 -2.9) (xy 5.1 -1.9) (xy 5.1 2.9) (xy -5.1 2.9)) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
  (fp_line (start 0 -2.9) (end 0 2.9) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_poly (pts (xy -5.3 -3.35) (xy 4.15 -3.35) (xy 5.3 -2.2) (xy 5.3 3.35) (xy -5.3 3.35)) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
  (fp_rect (start -5.45 -3.5) (end 5.45 3.5) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at 0 -1.9) (size 2.5 2.5) (drill 2.5) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 0 1.9) (size 2.5 2.5) (drill 2.5) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at 2.75 -1.27) (size 1.6 1.6) (drill 0.95) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.75 1.27) (size 1.6 1.6) (drill 0.95) (layers "*.Cu" "*.Mask"))
